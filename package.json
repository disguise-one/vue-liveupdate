    "@vue/test-utils": "^2.5.1",
    "jsdom": "^31.0.0",
    "rollup": "^4.68.2",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-vue": "^6.0.0",
    "tsd": "^0.33.0",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-ts": "^1.3.2-1",
    "vitest": "^5.1.0"
