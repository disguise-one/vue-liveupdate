{
  "name": "@disguise-one/vue-liveupdate",
  "version": "1.2.0",
  "type": "module",
  "description": "Disguise Live Update WebSocket composable & helper component for live read & write of values into a disguise session.",
  "author": "Disguise",
  "license": "ISC",
  "main": "dist/vue-liveupdate.umd.js",
  "module": "dist/vue-liveupdate.esm.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "rollup -c",
